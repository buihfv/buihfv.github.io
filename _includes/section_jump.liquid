{% comment %}
  Highlights the section the reader is currently in, inside .section-jump.
  Local include — not part of any al-folio gem.
{% endcomment %}
<script>
  (function () {
    var nav = document.querySelector('.section-jump');
    if (!nav || !('IntersectionObserver' in window)) return;
    var links = Array.prototype.slice.call(nav.querySelectorAll('a[href^="#"]'));
    var map = {};
    var targets = [];
    links.forEach(function (a) {
      var el = document.getElementById(decodeURIComponent(a.getAttribute('href').slice(1)));
      if (el) { map[el.id] = a; targets.push(el); }
    });
    if (!targets.length) return;
    function setActive(a) {
      links.forEach(function (l) { l.classList.toggle('is-active', l === a); });
    }
    setActive(map[targets[0].id]);
    var seen = {};
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { seen[e.target.id] = e.intersectionRatio > 0 ? e.boundingClientRect.top : null; });
      var best = null, bestTop = Infinity;
      targets.forEach(function (t) {
        var r = t.getBoundingClientRect();
        if (r.top <= 140 && r.bottom > 140) { best = t; bestTop = 0; }
      });
      if (!best) {
        targets.forEach(function (t) {
          var r = t.getBoundingClientRect();
          if (r.top > 0 && r.top < bestTop) { bestTop = r.top; best = t; }
        });
      }
      if (best) setActive(map[best.id]);
    }, { rootMargin: '-120px 0px -55% 0px', threshold: [0, 0.01, 0.5, 1] });
    targets.forEach(function (t) { io.observe(t); });
  })();
</script>
