#!/bin/bash
# gpu_submit (self-contained 버전)
# 사용법: gpu_submit [vasp_std|vasp_gam|vasp_ncl] [-np N] [-gpu idx1 idx2 ...]
#   예) gpu_submit vasp_gam -np 2                     (자동 선택: 메모리 적은 순)
#       gpu_submit -np 1 -gpu 3                        (GPU 3번을 직접 지정)
#       gpu_submit vasp_std -np 2 -gpu 3 4              (GPU 3,4번을 직접 지정, 띄어쓰기 구분)
#       gpu_submit vasp_gam -np 3 -gpu 4 5 6            (GPU 4,5,6번을 직접 지정)
#       gpu_submit -np 2 -gpu 3,4                        (쉼표 구분도 그대로 지원)
#   GPU 번호는 nvidia-smi 기준 0~7 그대로 쓰면 됩니다.
#
# 이 스크립트는 /home/irteam/bin/vasp_run 에 의존하지 않습니다.
# GPU 선택, CUDA_VISIBLE_DEVICES 매핑, mpirun 실행 로직을 모두 내장하고 있습니다.

VASP_GPU_BINDIR="/home1/irteam/data-vol1/vasp_GPU/vasp.6.6.0/bin"
THRESHOLD_MB=15000
NP=2
NP_EXPLICIT=0
VASP_MODEL="vasp_std"
MANUAL_GPUS=""   # -gpu 로 지정하면 채워짐 (비어있으면 자동 선택), 내부적으로는 쉼표로 join

while [[ $# -gt 0 ]]; do
  case "$1" in
    -np) NP="$2"; NP_EXPLICIT=1; shift 2 ;;
    -gpu)
      shift
      GPU_TOKENS=()
      # 다음 옵션(-로 시작) 또는 모델명 키워드가 나오기 전까지 계속 숫자를 수집
      while [[ $# -gt 0 && "$1" != -* && "$1" != "vasp_std" && "$1" != "vasp_gam" && "$1" != "vasp_ncl" ]]; do
        # 콤마로 이미 구분된 토큰(예: "3,4")도 지원
        IFS=',' read -ra SPLIT <<< "$1"
        GPU_TOKENS+=("${SPLIT[@]}")
        shift
      done
      MANUAL_GPUS=$(IFS=,; echo "${GPU_TOKENS[*]}")
      ;;
    vasp_std|vasp_gam|vasp_ncl) VASP_MODEL="$1"; shift ;;
    *) shift ;;
  esac
done

# -gpu로 GPU 개수를 직접 지정한 경우, 실제 rank 수는 항상 그 GPU 개수를 따릅니다.
# -np 값과 다르면(혹은 -np를 안 줬으면) 여기서 명확히 정리하고 알려줍니다.
if [ -n "$MANUAL_GPUS" ]; then
  IFS=',' read -ra _GPU_COUNT_ARR <<< "$MANUAL_GPUS"
  GPU_COUNT=${#_GPU_COUNT_ARR[@]}
  if [ "$NP_EXPLICIT" -eq 1 ] && [ "$NP" -ne "$GPU_COUNT" ]; then
    echo "안내: -np ${NP}와 -gpu로 지정한 GPU 개수(${GPU_COUNT}개)가 다릅니다."
    echo "      실제 rank 수는 지정한 GPU 개수를 따르므로, -np는 ${GPU_COUNT}로 맞춥니다."
    NP=$GPU_COUNT
  elif [ "$NP_EXPLICIT" -eq 0 ]; then
    NP=$GPU_COUNT
  fi
fi

VASP_BIN="$VASP_GPU_BINDIR/$VASP_MODEL"

echo "선택된 VASP 모델: $VASP_MODEL"
echo "요청 GPU 개수: $NP"
if [ -n "$MANUAL_GPUS" ]; then
  echo "할당 GPU: $(echo "$MANUAL_GPUS" | tr ',' ' ')"
fi
echo ""

if [ ! -f "$VASP_BIN" ]; then
  echo "오류: GPU 전용 VASP 바이너리를 찾을 수 없습니다: $VASP_BIN"
  echo "사용 가능한 바이너리 목록:"
  ls "$VASP_GPU_BINDIR" 2>/dev/null
  exit 1
fi

##############################################
# GPU 지정 방식 분기: 수동(-gpu) vs 자동
##############################################
if [ -n "$MANUAL_GPUS" ]; then
  echo "--- 지정한 GPU의 실제 점유 상태 (연산 사용률 + 프로세스 유무 기준) ---"

  UTIL_TABLE=$(nvidia-smi --query-gpu=index,utilization.gpu,memory.free --format=csv,noheader,nounits)

  CONFLICT=0
  IFS=',' read -ra GPU_ARR <<< "$MANUAL_GPUS"
  for g in "${GPU_ARR[@]}"; do
    util=$(echo "$UTIL_TABLE" | awk -F', ' -v idx="$g" '$1==idx{print $2}')
    free=$(echo "$UTIL_TABLE" | awk -F', ' -v idx="$g" '$1==idx{print $3}')
    procs=$(nvidia-smi --query-compute-apps=pid,used_memory,gpu_uuid --format=csv,noheader | while IFS=',' read -r pid mem uuid; do
      pid=$(echo "$pid" | xargs); mem=$(echo "$mem" | xargs); uuid=$(echo "$uuid" | xargs)
      idx=$(nvidia-smi --query-gpu=index,uuid --format=csv,noheader | awk -F', ' -v u="$uuid" '$2==u{print $1}')
      [ "$idx" = "$g" ] && echo "$pid"
    done)
    proc_count=$(echo "$procs" | grep -c . 2>/dev/null || echo 0)
    [ -z "$procs" ] && proc_count=0

    if [ "$proc_count" -gt 0 ] || [ "${util:-0}" -ge 10 ]; then
      echo "  GPU $g : 연산 사용률 ${util}%, 여유메모리 ${free}MiB -> 이미 사용 중 (프로세스 ${proc_count}개)"
      CONFLICT=1
    else
      echo "  GPU $g : 연산 사용률 ${util}%, 여유메모리 ${free}MiB -> 완전히 비어있음 (OK)"
    fi
  done
  echo ""

  if [ "$CONFLICT" -eq 1 ]; then
    echo "경고: 지정한 GPU 중 이미 연산 중이거나 프로세스가 있는 GPU가 있습니다."
    echo "연산 사용률이 높으면 메모리가 남아 있어도 새 job과 서로 느려집니다."
    echo "job 1개당 GPU 1개 원칙을 지키려면 완전히 빈 GPU를 고르는 걸 권장합니다."
    read -p "그래도 진행할까요? (y/N): " ans
    if [[ "$ans" != "y" && "$ans" != "Y" ]]; then
      echo "취소되었습니다. 'resource_status'로 빈 GPU를 확인 후 다시 시도하세요."
      exit 1
    fi
  fi

  SELECTED_GPUS="$MANUAL_GPUS"
  ACTUAL_COUNT=${#GPU_ARR[@]}
else
  AVAILABLE=$(nvidia-smi --query-gpu=index,memory.free --format=csv,noheader,nounits \
    | awk -F', ' -v t="$THRESHOLD_MB" '$2>=t {print $1, $2}' \
    | sort -k2 -rn)
  COUNT=$(echo "$AVAILABLE" | grep -c .)
  echo "여유 있는 GPU 목록 (메모리 기준, 참고용):"
  echo "$AVAILABLE" | awk '{printf "  GPU %-2s : %s MiB free\n", $1, $2}'
  echo ""
  echo "--- 참고: 전체 GPU 연산 사용률 ---"
  nvidia-smi --query-gpu=index,utilization.gpu,memory.free --format=csv,noheader,nounits \
    | awk -F', ' '{printf "  GPU %-2s : 사용률 %3s%%, 여유메모리 %s MiB\n", $1, $2, $3}'
  echo ""
  echo "※ 메모리만 보고 자동 선택하면 이미 연산 중인 GPU에 겹쳐 탈 수 있습니다."
  echo "  완전히 빈 GPU를 직접 고르고 싶으면 위 사용률을 참고해 '-gpu <번호>'로 지정하세요."
  echo ""

  if [ "$COUNT" -lt "$NP" ]; then
    echo "경고: 요청한 $NP개 중 메모리 여유 있는 GPU는 ${COUNT}개뿐입니다."
    read -p "그래도 진행할까요? (y/N): " ans
    if [[ "$ans" != "y" && "$ans" != "Y" ]]; then
      echo "취소되었습니다."
      exit 1
    fi
  fi
  SELECTED_GPUS=""   # 자동 선택은 실행 시점(nohup 내부)에서 다시 계산
  ACTUAL_COUNT=""
fi

echo ""
echo "현재 디렉토리: $(pwd)"
if [ ! -f INCAR ] || [ ! -f POSCAR ] || [ ! -f KPOINTS ]; then
  echo "경고: 현재 디렉토리에 INCAR/POSCAR/KPOINTS 파일이 없습니다. 위치를 확인하세요."
  read -p "그래도 진행할까요? (y/N): " ans2
  if [[ "$ans2" != "y" && "$ans2" != "Y" ]]; then
    exit 1
  fi
fi

JOB_DIR="$(pwd)"
JOB_LABEL="$(basename "$JOB_DIR")"

nohup bash -c "
  set -euo pipefail

  if [ -n '$SELECTED_GPUS' ]; then
    AVAILABLE_GPUS='$SELECTED_GPUS'
    ACTUAL_COUNT=$ACTUAL_COUNT
  else
    AVAILABLE_GPUS=\$(nvidia-smi --query-gpu=index,memory.used --format=csv,noheader,nounits \
      | awk '{print \$1, \$2}' \
      | sort -n -k 2 -k 1 \
      | awk '{print \$1}' \
      | awk '!seen[\$0]++' \
      | head -n $NP \
      | paste -sd, -)
    ACTUAL_COUNT=\$(echo \"\$AVAILABLE_GPUS\" | tr ',' '\n' | grep -v '^\$' | wc -l || echo 0)
  fi

  CLEAN_LD=\$(printf '%s' \"\${LD_LIBRARY_PATH:-}\" | tr ':' '\n' \
    | awk 'NF' \
    | grep -vE '^/opt/conda/lib(/.*)?\$|/home1?/irteam/hbkim/vasp/lib(/.*)?\$|^/home/irteam/fix_gomp(/.*)?\$' \
    | awk '!seen[\$0]++' \
    | paste -sd: -)
  export LD_LIBRARY_PATH=\"\$HOME/bin/safe_libs:\$CLEAN_LD\"
  unset LD_PRELOAD
  export OMP_NUM_THREADS=\"\${OMP_NUM_THREADS:-1}\"
  export OMP_STACKSIZE=\"\${OMP_STACKSIZE:-512m}\"
  export CUDA_VISIBLE_DEVICES=\"\$AVAILABLE_GPUS\"

  OUT_FILENAME=\$(date \"+%Y.%m.%d_%H-%M.out\")
  SELECTED_GPUS_SPACED=\$(echo \"\$CUDA_VISIBLE_DEVICES\" | tr ',' ' ')

  mpirun -np \"\$ACTUAL_COUNT\" bash -c '
    gpus=('\"\$SELECTED_GPUS_SPACED\"')
    local_rank=\${OMPI_COMM_WORLD_LOCAL_RANK:-\${MPI_LOCALRANKID:-0}}
    export CUDA_VISIBLE_DEVICES=\${gpus[\$local_rank]}
    exec \"\$0\" \"\$@\"
  ' '$VASP_BIN' < /dev/null > \"\$OUT_FILENAME\" 2>&1

  /home/irteam/ymjo/bin/vasp_notify.sh '$JOB_DIR' '$JOB_LABEL' > /dev/null 2>&1
" > /dev/null 2>&1 &
disown
sleep 1

echo ""
echo "제출 완료."
echo ""
echo "선택된 VASP 모델: $VASP_MODEL"
if [ -n "$MANUAL_GPUS" ]; then
  echo "할당된 GPU: $(echo "$MANUAL_GPUS" | tr ',' ' ')"
else
  echo "할당된 GPU: (자동 선택, 메모리 여유 순 ${NP}개)"
fi
echo ""
echo "최근 생성된 출력 파일:"
ls -t *.out 2>/dev/null | head -1
echo ""

# 실제 rank 프로세스가 뜰 때까지 잠깐 대기 후 PID 수집 (최대 10초, 1초 간격 재시도)
echo "계산 프로세스 확인 중..."
JOB_DIR_REAL=$(readlink -f "$JOB_DIR")
FOUND_PIDS=""
for i in $(seq 1 10); do
  FOUND_PIDS=$(ps -ef | grep "$VASP_BIN" | grep -v grep | awk '{print $2}' | while read -r p; do
    cwd=$(readlink -f "/proc/$p/cwd" 2>/dev/null)
    [ "$cwd" = "$JOB_DIR_REAL" ] && echo "$p"
  done)
  [ -n "$FOUND_PIDS" ] && break
  sleep 1
done

echo ""
if [ -n "$FOUND_PIDS" ]; then
  PID_LIST=$(echo "$FOUND_PIDS" | paste -sd' ' -)
  echo "이 계산의 PID: $PID_LIST"
  echo ""
  echo "종료하려면 아래 명령을 그대로 복사해서 실행하세요:"
  echo "  kill $PID_LIST"
else
  echo "경고: 계산 프로세스를 아직 찾지 못했습니다 (초기 로딩이 오래 걸리는 경우일 수 있음)."
  echo "잠시 후 아래 명령으로 직접 확인하세요:"
  echo "  ps -ef | grep '$VASP_BIN' | grep -v grep"
  echo "  → 나온 PID들을 'ls -l /proc/<PID>/cwd' 로 이 디렉토리인지 확인 후 kill <PID>"
fi
echo ""
echo "※ pkill -f 등 넓은 패턴 매치는 절대 사용하지 마세요 (다른 job과 경로 문자열이 겹칠 수 있습니다)."
